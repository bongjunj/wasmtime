;; Validate: (x & y) | (~x & y) == y

test interpret
test run
target x86_64
target aarch64
target riscv64
target s390x

function %band_notx_y(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = band v0, v1
    v3 = bnot v0
    v4 = band v3, v1
    v5 = bor v2, v4
    return v5
}

; run: %band_notx_y(0x12345678, 0x9abcdef0) == 0x9abcdef0
; run: %band_notx_y(0xffffffff, 0x1) == 0x1
; run: %band_notx_y(0x0, 0xffffffff) == 0xffffffff
; run: %band_notx_y(0xdeadbeef, 0x55aa55aa) == 0x55aa55aa
; run: %band_notx_y(0x80000000, 0x7fffffff) == 0x7fffffff


