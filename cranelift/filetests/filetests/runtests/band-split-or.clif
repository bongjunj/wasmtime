;; Validate: (x & y) | (x & ~y) == x

test interpret
test run
target x86_64
target aarch64
target riscv64
target s390x

function %band_split_or(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = band v0, v1
    v3 = bnot v1
    v4 = band v0, v3
    v5 = bor v2, v4
    return v5
}

; run: %band_split_or(0x12345678, 0x1) == 0x12345678
; run: %band_split_or(0xdeadbeef, 0x55aa55aa) == 0xdeadbeef
; run: %band_split_or(0xffffffff, 0x0) == 0xffffffff
; run: %band_split_or(0x0, 0xffffffff) == 0x0
; run: %band_split_or(0x80000000, 0x7fffffff) == 0x80000000


