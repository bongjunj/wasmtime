;; Validate: (~x) | (~y) == ~(x & y)

test interpret
test run
target x86_64
target aarch64
target riscv64
target s390x

function %bor_not_neg1(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bxor v0, iconst.i32 -1
    v3 = bxor v1, iconst.i32 -1
    v4 = bor v2, v3
    return v4
}

; run: %bor_not_neg1(0x0, 0x0) == 0xffffffff
; run: %bor_not_neg1(0x12345678, 0x9abcdef0) == 0xedcba98f
; run: %bor_not_neg1(0xffffffff, 0x1) == 0xfffffffe
; run: %bor_not_neg1(0x80000000, 0x7fffffff) == 0xffffffff
; run: %bor_not_neg1(0xdeadbeef, 0x10) == 0xffffffff


