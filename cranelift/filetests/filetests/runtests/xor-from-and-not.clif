;; Validate: (x & ~y) | (~x & y) == (x ^ y)

test interpret
test run
target x86_64
target aarch64
target riscv64
target s390x

function %xor_from_and_not(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bnot v1
    v3 = band v0, v2
    v4 = bnot v0
    v5 = band v4, v1
    v6 = bor v3, v5
    return v6
}

; run: %xor_from_and_not(0x12345678, 0x9abcdef0) == 0x88888888
; run: %xor_from_and_not(0xffffffff, 0x1) == 0xfffffffe
; run: %xor_from_and_not(0x0, 0xffffffff) == 0xffffffff
; run: %xor_from_and_not(0xdeadbeef, 0x55aa55aa) == 0x8b07eb45
; run: %xor_from_and_not(0x80000000, 0x7fffffff) == 0xffffffff


