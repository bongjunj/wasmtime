;     v5 = bnot v1
;     v6 = band v0, v5
;     return v6
; }



function %fold_add_or_neg_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = bor v0, v1
    v3 = ineg v1
    v4 = iadd v2, v3
    return v4
}

