test optimize precise-output
set opt_level=speed
target x86_64

function %fold_nested_selects(i8, i32, i32) -> i32 {
block0(v0: i8, v1: i32, v2: i32):
    v3 = icmp eq v1, v2
    v4 = select v3, v1, v2
    v5 = select v0, v2, v1
    v6 = select v0, v4, v5
    return v6
}

; function %fold_nested_selects(i8, i32, i32) -> i32 fast {
