;     return v5
; }



function %fold_select_neg_mul_i64(i64, b1) -> i64 {
block0(v0: i64, v1: b1):
    v2 = select v1, iconst.i64 -1, iconst.i64 1
    v3 = imul v2, v0
    return v3
}

