test optimize precise-output
set opt_level=speed
target x86_64

function %fold_select_neg_mul_i32(i32, b1) -> i32 {
block0(v0: i32, v1: b1):
    v2 = select v1, iconst.i32 -1, iconst.i32 1
    v3 = imul v2, v0
    return v3
}

