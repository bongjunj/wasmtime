test optimize precise-output
set opt_level=speed
target x86_64

function %fold_band_notx_y_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = band v0, v1
    v3 = bnot v0
    v4 = band v3, v1
    v5 = bor v2, v4
    return v5
}

; function %fold_band_notx_y_i32(i32, i32) -> i32 fast {
; block0(v0: i32, v1: i32):
;     return v1
; }



function %fold_band_notx_y_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = band v0, v1
    v3 = bnot v0
    v4 = band v3, v1
    v5 = bor v2, v4
    return v5
}

