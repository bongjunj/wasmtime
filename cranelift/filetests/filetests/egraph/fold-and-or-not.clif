test optimize precise-output
set opt_level=speed
target x86_64

function %test1(i8, i8) -> i8 {
block0(v0: i8, v2: i8):
    v1 = bnot v0
    v3 = bor v1, v2
    v4 = band v0, v3
    return v4
}

; function %test1(i8, i8) -> i8 fast {
; block0(v0: i8, v2: i8):
;     v5 = band v0, v2
;     return v5
; }

