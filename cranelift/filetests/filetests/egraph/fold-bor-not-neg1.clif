test optimize precise-output
set opt_level=speed
target x86_64

function %fold_bor_not_neg1_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = bxor v0, iconst.i32 -1
    v3 = bxor v1, iconst.i32 -1
    v4 = bor v2, v3
    return v4
}

