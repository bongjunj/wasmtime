; }



function %fold_bor_not_neg1_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = bxor v0, iconst.i64 -1
    v3 = bxor v1, iconst.i64 -1
    v4 = bor v2, v3
    return v4
}

